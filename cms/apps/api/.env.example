# Astauria CMS - Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5441/astauria_cms?schema=public"

# JWT
# Required in production. Generate a unique value, for example with:
# openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Exact browser origins allowed by CORS (comma-separated).
ADMIN_URL="http://localhost:5173"
PUBLIC_URL="http://localhost:5500"
CORS_ORIGINS=""
CORS_CREDENTIALS="false"
# Set to the exact number of reverse proxies in front of the API.
TRUST_PROXY_HOPS="0"

# Server
PORT=3001
SWAGGER_ENABLED="false"

# Required only when running `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrateur Astauria"

# Meta WhatsApp Cloud API (Notifications)
WHATSAPP_API_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="123456789"
WHATSAPP_NOTIFICATION_DESTINATION="33600000000"
